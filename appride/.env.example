# Copy this file to `.env` in the same folder and fill in your Firebase + Maps keys.
# Expo automatically loads EXPO_PUBLIC_* variables for use in JS and in `app.config.ts`.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# From Firebase Console → Project settings, or google-services.json → storage_bucket
# New projects: your-project-id.firebasestorage.app (not .appspot.com)
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Set to 1 to auto-advance ride states (searching → completed) without a second device — class demos only.
EXPO_PUBLIC_AUTO_SIMULATE_DRIVER=0

# Firebase Auth → Google: Web client ID (Authentication → Sign-in method → Google → Web client ID).
# Needed for @react-native-google-signin + Firebase on Android / iOS (dev build, not Expo Go).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google Sign-In native module: MUST be 0 in Expo Go (QR scan) or the app can crash on launch.
# Set to 1 only after `npx expo run:android` / EAS dev build.
EXPO_PUBLIC_GOOGLE_SIGNIN_NATIVE=0

# Push / local notifications: MUST be 0 in Expo Go (SDK 53 removed Android push in Expo Go).
# Set to 1 only after a dev build: `npx expo run:android`.
EXPO_PUBLIC_PUSH_NATIVE=0

# Leave 0 for Expo Go / Metro dev. Set to 1 only for production EAS builds with OTA updates.
EXPO_PUBLIC_ENABLE_OTA_UPDATES=0

# Payments: demo = Firestore audit only. live = calls your Paystack server (npm run server).
# On a physical phone, use your PC LAN IP (ipconfig), not localhost — e.g. http://192.168.1.5:5000
EXPO_PUBLIC_PAYMENT_MODE=demo
EXPO_PUBLIC_PAYMENT_API_BASE=http://192.168.1.5:5000
EXPO_PUBLIC_PAYMENT_VERIFY_URL=
EXPO_PUBLIC_PAYMENT_PROVIDER=paystack
EXPO_PUBLIC_PAYMENT_CURRENCY=NGN
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Paystack server only (never EXPO_PUBLIC_ — stays on your machine)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
BASE_URL=https://api.paystack.co
PORT=5000

# Voice search: MUST be 0 (or unset) when using Expo Go (QR scan). Expo Go crashes if this is 1.
# Set to 1 only after building a dev client: `npx expo run:android` (includes native speech module).
EXPO_PUBLIC_VOICE_NATIVE=0

# Fixes Expo CLI crash: "Body is unusable: Body has already been read" during startup
# (skips remote native-modules version check). npm scripts set this automatically too.
EXPO_NO_DEPENDENCY_VALIDATION=1
