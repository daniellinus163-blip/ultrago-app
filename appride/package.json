{
  "name": "appride",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "index.ts",
  "scripts": {
    "postinstall": "node ./scripts/prune-dangling-native-voice.js",
    "prestart": "node ./scripts/prune-dangling-native-voice.js",
    "start": "cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --lan",
    "start:clear": "node ./scripts/prune-dangling-native-voice.js && cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --clear --lan",
    "start:expo-go": "node ./scripts/prune-dangling-native-voice.js && node ./scripts/clear-expo-cache.js && cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 EXPO_PUBLIC_VOICE_NATIVE=0 EXPO_PUBLIC_GOOGLE_SIGNIN_NATIVE=0 EXPO_PUBLIC_PUSH_NATIVE=0 EXPO_PUBLIC_ENABLE_OTA_UPDATES=0 expo start --clear --lan",
    "android": "node ./scripts/prune-dangling-native-voice.js && cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --android",
    "run:android": "node ./scripts/prune-dangling-native-voice.js && cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo run:android",
    "setup:android-env": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-android-env.ps1",
    "setup:jdk-env": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows-jdk-env.ps1",
    "ios": "node ./scripts/prune-dangling-native-voice.js && cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --ios",
    "web": "node ./scripts/prune-dangling-native-voice.js && cross-env EXPO_NO_DEPENDENCY_VALIDATION=1 expo start --web",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit",
    "server": "node server.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "axios": "^1.16.1",
    "babel-preset-expo": "~54.0.10",
    "dotenv": "^17.4.2",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.10",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.15",
    "expo-speech-recognition": "^3.1.3",
    "expo-status-bar": "~3.0.9",
    "express": "^5.2.1",
    "firebase": "^11.10.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "~19.1.0",
    "cross-env": "^7.0.3",
    "typescript": "~5.9.2"
  },
  "private": true
}
